[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
serve = "mkdocs serve --livereload -a=localhost:4300"
serve-mcp = "mkdocs-mcp"

[packages]
certifi = ">=2023.7.22"
click = "~=8.1"
livereload = "~=2.6"
mkdocs = "~=1.6.1"
mkdocs-glightbox = "*"
mkdocs-llmstxt = "==0.5.1"
mkdocs-material = "~=9.5"
Pygments = "~=2.16"
requests = "~=2.32"

[dev-packages]
mkdocs-mcp-plugin = "*"
pymilvus = {extras = ["milvus_lite"], version = "*"}

[requires]
python_version = "3.14"
